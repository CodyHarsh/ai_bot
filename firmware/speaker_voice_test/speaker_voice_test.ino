/*
  SPEAKER VOICE TEST  (speaker only: no microphone, no OLED needed)

  It makes the speaker SAY something:  "Hello! I am Pip. Can you hear me?"
  The voice is stored inside this sketch, so it needs NO WiFi and NO server.

  Wiring (amp only):  MAX98357A  VIN -> ESP32 5V     GND -> GND
                                 BCLK -> GPIO14      LRC -> GPIO25      DIN -> GPIO22
                      speaker wires on the amp's + and - screw terminals (NOT on GND)

  What happens: at power-up it plays 3 beeps, then the voice, then waits for keys in the Serial Monitor (115200).
  Keys:  1 beeps   2 built-in voice   3 voice from your Mac server (set USE_SERVER)   4 wiring sweep
         + / -  volume     a  play everything again     m  menu
  Nothing audible? Press 4: it tries BCLK/LRC the other way round and says which one you should hear.
*/
#include <ESP_I2S.h>
#include <WiFi.h>

// ---- settings -----------------------------------------------------------------------------
#define USE_SERVER   0              // 1 = also fetch a voice from the Mac server (key 3). Needs the lines below.
#define WIFI_SSID    "YOUR_WIFI_NAME"
#define WIFI_PASS    "YOUR_WIFI_PASSWORD"
#define SERVER_HOST  "192.168.1.50" // your Mac's current IP, the server must be running
#define SERVER_PORT  8000
#define SERVER_TEXT  "Hello! I am Pip. I am talking from the server."

#define PIN_BCLK 14
#define PIN_WS   25
#define PIN_DOUT 22
#define PIN_DIN  33                 // set but never read: the microphone is not used here
#define PIN_LED  2

int volumePct = 200;                // 100 = as recorded. 200 = louder (soft limited). Keys + and - change it.
// ---------------------------------------------------------------------------------------------

#define LOGI(tag, ...) do { Serial.printf("[%8lu] %-5s ", millis(), tag); Serial.printf(__VA_ARGS__); Serial.println(); } while (0)

I2SClass i2s;
bool i2sOn = false;
int curBclk = PIN_BCLK, curWs = PIN_WS;
unsigned long totalWritten = 0;

