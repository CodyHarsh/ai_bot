# Copy this file to .env (same folder as server.py) and fill in the keys you have.
# .env is ignored by git. Never paste real keys into chat, code or commits.
# Order Pip tries them in: GROQ (main) -> OPENAI (ChatGPT) -> GEMINI -> built-in replies
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional extras (only used if you add them to LLM_CHAIN)
# ANTHROPIC_API_KEY=
# LLM_CHAIN=groq,openai,gemini
# GROQ_MODEL=llama-3.1-8b-instant
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.5-flash
# TTS_VOICE=en-US-AnaNeural
# WHISPER_MODEL=base.en
